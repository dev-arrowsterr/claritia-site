# Hostinger (LiteSpeed/Apache) settings for the static Claritia site
ErrorDocument 404 /404.html
DirectoryIndex index.html

# Text files are UTF-8
AddDefaultCharset utf-8
AddType "text/markdown; charset=utf-8" .md
AddType "text/plain; charset=utf-8" .txt
<IfModule mod_headers.c>
  <FilesMatch "\.(md|txt)$">
    Header set X-Content-Type-Options "nosniff"
  </FilesMatch>
</IfModule>

RewriteEngine On
# One host: www -> apex, http -> https
RewriteCond %{HTTP_HOST} ^www\.tryclaritia\.com$ [NC]
RewriteRule ^(.*)$ https://tryclaritia.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Hostinger deploys the whole repo here, so hide the git folder, dot files and the README
RewriteRule (^|/)\.(?!well-known/) - [F]
RewriteRule ^README\.md$ - [F]

# Old app links on this domain go to the same path on the app. The query string comes along.
RewriteRule ^((tests|blocks|runs|environments|schedules|approvals|insights|settings|start)(/.*)?)$ https://app.tryclaritia.com/$1 [R=301,L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType text/html "access plus 10 minutes"
</IfModule>
